# Modelo usado para interpretar as respostas e redigir a fala final
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Bot que avisa a família quando o risco passa do limiar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Skill da Alexa (usado para validar que a requisição veio da nossa skill)
ALEXA_SKILL_ID=

# Limiar de risco (0 a 100) acima do qual a família é avisada
RISK_ALERT_THRESHOLD=70

# Observabilidade (Langfuse Cloud): traces do grafo, latência e custo por etapa
# Use dados fictícios nos testes; desligue com LANGFUSE_ENABLED=false
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
